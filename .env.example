# Application configuration contract (requirement.md §18.2).
# Copy to .env.local and fill in real values for local development.
# Never commit a file with real secrets.

# Required.
# One of: local | test | demo | preview | production
APP_ENV=local

# Optional for now; becomes required once Drizzle is wired (Commit 5).
# Must be a valid PostgreSQL connection URL if set.
DATABASE_URL=

# Optional; validated if set. Not consumed by any code yet.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Client-safe (exposed to the browser). Optional; validated if set.
NEXT_PUBLIC_SENTRY_DSN=
