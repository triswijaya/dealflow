# Application configuration contract (requirement.md §18.2).
# Copy to .env.local and fill in real values for local development.
# Never commit a file with real secrets.

# Required.
# One of: local | test | demo | preview | production
APP_ENV=local

# Required. Pooled/runtime connection used by the app (server/db/client.ts).
DATABASE_URL=

# Required. Direct connection used only by drizzle-kit (migration job),
# never by the running app. Locally this is the same Postgres as
# DATABASE_URL; in production it points at a non-pooled endpoint (DEPLOY-03).
DATABASE_MIGRATION_URL=

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Base URL Better Auth uses for callbacks/cookies.
BETTER_AUTH_URL=

# Required. Canonical app URL for account/invitation links.
APP_URL=

# Required. "From" address used by the dev email sink (no real email is sent
# yet; see src/server/email/send-email.ts). A production provider is chosen
# closer to public launch.
EMAIL_FROM=

# Optional; validated if set. Not consumed by any code yet (no production
# email provider wired up).
EMAIL_PROVIDER_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Client-safe (exposed to the browser). Optional; validated if set.
NEXT_PUBLIC_SENTRY_DSN=
